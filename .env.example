# Copy to .env.local and fill in. Never commit real values.
# See README → Authentication for where each value comes from.

# openssl rand -base64 32
AUTH_SECRET=

# Site origin only, no path. Local: http://localhost:3000
# Production: https://nexus-pied-pi-49.vercel.app
AUTH_URL=

# Postgres connection string (Neon pooled URL on Vercel).
DATABASE_URL=

# Google OAuth web client. Redirect: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend magic-link email. From must be a verified Resend domain.
AUTH_RESEND_KEY=
EMAIL_FROM=

# Research web search (server-side). Optional: without it, Research still opens addresses.
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Nexus Command: encrypts connector tokens. openssl rand -base64 32
# Optional locally (falls back to a key derived from AUTH_SECRET); set it in production.
NEXUS_CREDENTIALS_KEY=

# Nexus Command OAuth apps. Redirect: {AUTH_URL}/api/command/oauth/<strava|spotify>/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
